# ============================================================
# BulletTrade 回测环境配置示例
# 复制此文件为 .env 即可用于回测
# ============================================================

# ============ 数据源配置（必需） ============

# 数据源类型 (stockdb, jqdata, tushare, qmt)
DEFAULT_DATA_PROVIDER=stockdb

# 通用数据缓存目录（各数据源使用 DATA_CACHE_DIR/<provider_name>，留空则禁用磁盘缓存）
DATA_CACHE_DIR=~/.bullet-trade/cache

# MiniQMT (可选，本地 QMT 行情)
#QMT_DATA_PATH=C:\国金QMT交易端模拟\userdata_mini
#MINIQMT_AUTO_DOWNLOAD=true
#MINIQMT_MARKET=SH

# StockDB（本地免费数据源，先运行 stockdb/数据更新.exe 同步数据）
STOCKDB_HOST=127.0.0.1
STOCKDB_PORT=7899
#STOCKDB_SDK_DIR=               # 指向 stockdb/pybao，留空时自动探测仓库同级路径
STOCKDB_AUTO_START=true         # 服务未启动时自动拉起 stockdb.exe
#STOCKDB_EXE=
STOCKDB_TIMEOUT=15
#STOCKDB_MINUTE_DAILY_FALLBACK=true   # 分钟线无数据时 count=1 行情探测回退当日日线（日频回测需要）

# ============ 回测默认参数 ============

# 默认初始资金
DEFAULT_INITIAL_CASH=100000

# 默认回测频率 (daily, minute)
DEFAULT_FREQUENCY=daily

# 默认基准
DEFAULT_BENCHMARK=510300.XSHG

# ============ 系统配置 ============

# 日志配置
LOG_DIR=./logs
LOG_LEVEL=INFO

# ============ 通知配置 ============
# 企业微信机器人 KEY，配置后 send_msg 会推送群机器人
MESSAGE_KEY=

# ============ 缓存配置 ============

# 启用缓存（提升性能）
ENABLE_CACHE=true

# 回测数据会话：行情块预取（多标的/长区间回测显著减少逐日查询）
BT_BACKTEST_DATA_SESSION=true
BT_BACKTEST_DATA_SESSION_PRICE_BLOCKS=true

# ============ 性能优化 ============

# 使用 uvloop（仅 macOS/Linux，提升性能）
USE_UVLOOP=true

# Portfolio 实时刷新（毫秒），默认 200；若需更高频访问可调小
PORTFOLIO_REFRESH_THROTTLE_MS=200

# ============ 回测建议配置 ============
# 
# 日线回测：
#   DEFAULT_FREQUENCY=daily
#   USE_UVLOOP=true
#
# 分钟回测：
#   DEFAULT_FREQUENCY=minute
#   USE_UVLOOP=true   # 异步模式性能更好
#
# 参数优化：
#   ENABLE_CACHE=true # 必须开启缓存

# 远程 QMT server
QMT_SERVER_HOST=127.0.0.1
QMT_SERVER_PORT=58620
QMT_SERVER_TOKEN=please_change_me
